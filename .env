JAVA_TOOL_OPTIONS="-javaagent:agent/opentelemetry-javaagent.jar"
OTEL_TRACES_EXPORTER="zipkin"
OTEL_METRICS_EXPORTER="prometheus"
OTEL_LOGS_EXPORTER="otlp"
OTEL_EXPORTER_OTLP_ENDPOINT="http://localhost:4317"
OTEL_EXPORTER_OTLP_PROTOCOL="grpc"
OTEL_METRIC_EXPORT_INTERVAL=15000
OTEL_SERVICE_NAME=persona-v1
#OTEL_EXPORTER_JAEGER_ENDPOINT=http://localhost:14250
OTEL_EXPORTER_ZIPKIN_ENDPOINT=http://localhost:9411/api/v2/spans

## PROMETHEUS
#### prometheus podra conectarse a este host y puerto para obtener las metricas desde cualquier interfaz de red
OTEL_EXPORTER_PROMETHEUS_HOST=0.0.0.0
#### puerto donde prometheus podra conectarse para obtener las metricas, puerto por donde la app publicara las metricas
OTEL_EXPORTER_PROMETHEUS_PORT=9464