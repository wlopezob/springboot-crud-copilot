JAVA_TOOL_OPTIONS="-javaagent:agent/opentelemetry-javaagent.jar"
OTEL_TRACES_EXPORTER="otlp"
OTEL_RESOURCE_ATTRIBUTES="service=crud-copilot-v1,env=dev"
OTEL_EXPORTER_OTLP_ENDPOINT="http://localhost:4317"
OTEL_LOGS_EXPORTER="otlp"
OTEL_EXPORTER_OTLP_PROTOCOL="grpc"
OTEL_INSTRUMENTATION_HTTP_CAPTURE_HEADERS_CLIENT_REQUEST="Request-ID"
OTEL_INSTRUMENTATION_HTTP_CLIENT_CAPTURE_REQUEST_HEADERS="Request-ID"